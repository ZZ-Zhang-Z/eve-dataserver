{
  "tick_seconds": 10,
  "timezone": "Asia/Shanghai",
  "python": "",
  "log_dir": "logs/controller",
  "task_log_dir": "logs/collectors",
  "state_file": "state.json",
  "lock_file": ".controller.lock",
  "plugin_modules": [],

  "resources": {
    "min_free_mem_mb": 180,
    "min_free_disk_mb": 2048,
    "max_load_per_core": 2.0
  },

  "tasks": {
    "orders": {
      "enabled": true,
      "desc": "吉他订单快照与变更事件",
      "runner": "runners/orders_once.py",
      "schedule": { "type": "interval", "minutes": 30, "align": true },
      "skip_windows": [["18:55", "19:45"]],
      "timeout_seconds": 300,
      "retry": { "max_attempts": 2, "delay_seconds": 120 },
      "env": { "EVE_RETENTION_HOURS": "24" }
    },

    "history": {
      "enabled": true,
      "desc": "全量成交历史（15216 个 type，约 40 分钟）",
      "runner": "runners/history_once.py",
      "schedule": { "type": "daily", "at": "08:00" },
      "timeout_seconds": 7200
    },

    "sde": {
      "enabled": true,
      "desc": "SDE 静态数据导入（约 95MB 下载）",
      "script": "collectors/item_sde_collector.py",
      "schedule": { "type": "weekly", "weekday": 6, "at": "09:30" },
      "timeout_seconds": 1800
    },

    "monthly": {
      "enabled": true,
      "desc": "月度历史聚合与数据库压缩",
      "script": "scripts/aggregate_monthly_history.py",
      "schedule": { "type": "monthly", "day": 1, "at": "04:30" },
      "timeout_seconds": 3600,
      "depends_on": ["history"]
    }
  }
}
